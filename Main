        window.onload = function() {
            updateDashboard();
        }

        // INCOME MANAGER CORE LOGIC
        function openIncomeManager() {
            const modal = document.getElementById('incomeModal');
            const card = modal.querySelector('div');
            
            renderIncomeManagerList();

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                card.classList.remove('scale-95');
            }, 10);
        }

        function closeIncomeManager() {
            const modal = document.getElementById('incomeModal');
            const card = modal.querySelector('div');

            modal.classList.add('opacity-0');
            card.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        function renderIncomeManagerList() {
            const container = document.getElementById('incomeListContainer');
            container.innerHTML = '';
            
            const incomeTx = transactions.filter(t => t.type === 'Income');
            
            if (incomeTx.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-2 opacity-50 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <p class="text-sm font-semibold text-slate-500">Belum ada data pemasukan</p>
                        <p class="text-xs text-slate-400 mt-1">Gunakan tombol di bawah untuk menambahkannya</p>
                    </div>
                `;
                return;
            }

            // Loop and show active income items
            [...incomeTx].reverse().forEach(t => {
                const item = document.createElement('div');
                item.className = 'flex items-center justify-between p-3.5 bg-slate-50 hover:bg-slate-100/70 rounded-2xl border border-slate-100 transition duration-150';
                item.innerHTML = `
                    <div class="space-y-1">
                        <p class="font-bold text-slate-800 text-sm">${t.name}</p>
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-bold text-slate-500 bg-white border border-slate-200 px-2 py-0.5 rounded-md">${t.category}</span>
                            <span class="text-[10px] text-slate-400 font-semibold">${new Date(t.date).toLocaleDateString('id-ID', {day:'2-digit', month:'short'})}</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="font-extrabold text-emerald-600 text-sm">+${formatIDR(t.amount)}</span>
                        <div class="flex items-center gap-1">
                            <button onclick="editFromManager(${t.id})" class="p-2 bg-white border border-slate-200 hover:bg-blue-50 hover:border-blue-200 text-blue-600 rounded-xl transition shadow-sm" title="Edit">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            </button>
                            <button onclick="deleteFromManager(${t.id})" class="p-2 bg-white border border-slate-200 hover:bg-rose-50 hover:border-rose-200 text-rose-600 rounded-xl transition shadow-sm" title="Hapus / Kurangi">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        </div>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function editFromManager(id) {
            closeIncomeManager();
            setTimeout(() => {
                editTransaction(id);
            }, 300);
        }

        function deleteFromManager(id) {
            closeIncomeManager();
            setTimeout(() => {
                confirmDelete(id);
            }, 300);
        }

        function quickAddIncome() {
            closeIncomeManager();
            setTimeout(() => {
                showTransactionForm();
                setFormType('Income');
            }, 300);
        }
    </script>
