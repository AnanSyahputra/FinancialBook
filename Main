                        <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400 font-bold text-sm">Rp</span>
                        <input type="number" id="formAmount" min="1" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-11 pr-4 py-3.5 text-slate-800 font-extrabold text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" required>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="pt-4 flex flex-col sm:flex-row gap-3">
                <button type="button" id="submitBtn" onclick="submitTransaction()" class="w-full sm:flex-1 btn-primary text-white py-4 rounded-xl font-bold shadow-md shadow-blue-200 flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span id="submitBtnText">Simpan Transaksi</span>
                </button>
                <button type="button" onclick="hideTransactionForm()" class="w-full sm:w-auto px-6 py-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-center transition duration-150">
                    Batal
                </button>
            </div>
        </section>
    </div>


