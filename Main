            { id: 19, date: '2026-05-18', name: 'Servis Motor', category: 'Transport', amount: 300000, type: 'Expense' }
        ];

        // Daftar kategori bawaan berdasarkan tipe
        const categoriesMap = {
            Expense: ['Makanan', 'Transport', 'Tagihan', 'Hiburan', 'Belanja', 'Lain-lain'],
            Income: ['Gaji', 'Bonus', 'Investasi', 'Lain-lain']
        };

        let currentFormType = 'Expense'; // Variabel state internal untuk form baru
        let editingId = null; // Menyimpan ID transaksi yang sedang diedit (null jika tambah baru)
        let deletingId = null; // Menyimpan ID transaksi yang akan dihapus
        let categoryChart;

        // Custom notification system
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `p-4 rounded-xl shadow-lg border text-sm font-semibold pointer-events-auto flex items-center gap-2 transition duration-300 transform translate-y-2 opacity-0`;
            
            if (type === 'success') {
                toast.className += ' bg-emerald-50 border-emerald-200 text-emerald-800';
            } else {
                toast.className += ' bg-rose-50 border-rose-200 text-rose-800';
            }
            
            toast.innerHTML = `
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span>${message}</span>
            `;
            
            container.appendChild(toast);
            
            // Animation Trigger
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 50);

            // Hide and clean
            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 3000);
        }

        function formatIDR(val) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
        }

        // VIEW NAVIGATION HANDLERS
        function showTransactionForm() {
            // Reset state editing
            editingId = null;
            document.getElementById('formView').querySelector('h1').innerText = "Tambah Transaksi";
            document.getElementById('formView').querySelector('p').innerText = "Masukkan detail transaksi riil Anda untuk langsung dihitung di dashboard.";
            document.getElementById('submitBtnText').innerText = "Simpan Transaksi";

            // Set default date to today
            document.getElementById('formDate').value = new Date().toISOString().split('T')[0];
            // Clear inputs
            document.getElementById('formName').value = '';
            document.getElementById('formAmount').value = '';
            // Default to Expense
            setFormType('Expense');

            const dashboard = document.getElementById('dashboardView');
            const form = document.getElementById('formView');

            dashboard.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
                dashboard.classList.add('hidden');
                form.classList.remove('hidden');
                setTimeout(() => {
                    form.classList.remove('opacity-0', 'scale-95');
                    form.classList.add('opacity-100', 'scale-100');
                }, 50);
            }, 300);
        }

        function hideTransactionForm() {
            const dashboard = document.getElementById('dashboardView');
            const form = document.getElementById('formView');

            form.classList.remove('opacity-100', 'scale-100');
            form.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
                form.classList.add('hidden');
                dashboard.classList.remove('hidden');
                setTimeout(() => {
                    dashboard.classList.remove('opacity-0', 'scale-95');
                    dashboard.classList.add('opacity-100', 'scale-100');
                }, 50);
            }, 300);
        }

        // FORM INTERNAL CONTROLS
        function setFormType(type) {
            currentFormType = type;
            const expBtn = document.getElementById('typeExpenseBtn');
            const incBtn = document.getElementById('typeIncomeBtn');

            if (type === 'Expense') {
                expBtn.className = "py-3 px-4 rounded-xl font-bold text-sm text-center transition duration-150 bg-white text-slate-800 shadow-sm";
                incBtn.className = "py-3 px-4 rounded-xl font-bold text-sm text-center transition duration-150 text-slate-600 hover:text-slate-900";
            } else {
                incBtn.className = "py-3 px-4 rounded-xl font-bold text-sm text-center transition duration-150 bg-white text-slate-800 shadow-sm";
                expBtn.className = "py-3 px-4 rounded-xl font-bold text-sm text-center transition duration-150 text-slate-600 hover:text-slate-900";
            }

            // Populate Category Select dynamically
            const categorySelect = document.getElementById('formCategory');
            categorySelect.innerHTML = '';
            categoriesMap[type].forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat;
                opt.innerText = cat;
                categorySelect.appendChild(opt);
            });
        }

        // SAVE CUSTOM USER TRANSACTION
        function submitTransaction() {
            const date = document.getElementById('formDate').value;
            const name = document.getElementById('formName').value.trim();
            const category = document.getElementById('formCategory').value;
            const amount = parseFloat(document.getElementById('formAmount').value);

            // Validation checks
            if (!date) {
                showToast("Silakan masukkan tanggal transaksi terlebih dahulu.", "error");
                return;
            }
            if (!name) {
                showToast("Silakan masukkan nama transaksi terlebih dahulu.", "error");
                return;
            }
            if (!amount || amount <= 0) {
                showToast("Silakan masukkan nominal transaksi yang valid (lebih besar dari 0).", "error");
                return;
            }

            if (editingId !== null) {
                // UPDATE MODE
                const index = transactions.findIndex(t => t.id === editingId);
                if (index !== -1) {
                    transactions[index].date = date;
                    transactions[index].name = name;
                    transactions[index].category = category;
                    transactions[index].amount = amount;
                    transactions[index].type = currentFormType;
                }
                editingId = null;
                showToast("Transaksi berhasil diperbarui!", "success");
            } else {
                // ADD MODE
                const newTransaction = {
                    id: Date.now(), // Generate unique timestamp-based ID
                    date: date,
                    name: name,
                    category: category,
                    amount: amount,
                    type: currentFormType
                };
                transactions.push(newTransaction);
                showToast("Transaksi berhasil disimpan secara langsung!");
            }
            
            // Recalculate and render dashboard view
            updateDashboard();
            hideTransactionForm();
        }

        // EDIT MODE ACTIVATION
        function editTransaction(id) {
            const transaction = transactions.find(t => t.id === id);
            if (!transaction) return;

            editingId = id;

            // Update Form UI texts
            document.getElementById('formView').querySelector('h1').innerText = "Edit Transaksi";
            document.getElementById('formView').querySelector('p').innerText = "Sesuaikan detail informasi keuangan Anda dan simpan perubahan.";
            document.getElementById('submitBtnText').innerText = "Simpan Perubahan";

            // Fill input elements
            document.getElementById('formDate').value = transaction.date;
            document.getElementById('formName').value = transaction.name;
            setFormType(transaction.type);
            document.getElementById('formCategory').value = transaction.category;
            document.getElementById('formAmount').value = transaction.amount;

            // Smooth SPA Transition
            const dashboard = document.getElementById('dashboardView');
            const form = document.getElementById('formView');

            dashboard.classList.add('opacity-0', 'scale-95');
            setTimeout(() => {
                dashboard.classList.add('hidden');
                form.classList.remove('hidden');
                setTimeout(() => {
                    form.classList.remove('opacity-0', 'scale-95');
                    form.classList.add('opacity-100', 'scale-100');
                }, 50);
            }, 300);
        }

        // DELETE HANDLERS (No native alert window used)
        function confirmDelete(id) {
            deletingId = id;
            const modal = document.getElementById('deleteModal');
            const card = modal.querySelector('div');

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                card.classList.remove('scale-95');
            }, 10);
        }

        function closeDeleteModal() {
            const modal = document.getElementById('deleteModal');
            const card = modal.querySelector('div');

            modal.classList.add('opacity-0');
            card.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                deletingId = null;
            }, 300);
        }

        function executeDelete() {
            if (deletingId === null) return;

            transactions = transactions.filter(t => t.id !== deletingId);
            updateDashboard();
            closeDeleteModal();
            showToast("Transaksi berhasil dihapus.", "success");
        }


        // DASHBOARD CALCULATOR AND VISUAL RENDERS
        function updateDashboard() {
            const catFilter = document.getElementById('categoryFilter').value;
            const periodFilter = document.getElementById('periodFilter').value;
            
            let filtered = transactions;

            // Apply Filters
            if (catFilter !== 'All') {
                filtered = filtered.filter(t => t.category === catFilter);
            }

            if (periodFilter !== 'All') {
                const days = parseInt(periodFilter);
                const cutoff = new Date();
                cutoff.setDate(cutoff.getDate() - days);
                filtered = filtered.filter(t => new Date(t.date) >= cutoff);
            }

            // Calculate Metrics
            const expenses = filtered.filter(t => t.type === 'Expense');
            const incomes = filtered.filter(t => t.type === 'Income');

            const totalExp = expenses.reduce((sum, t) => sum + t.amount, 0);
            const totalInc = incomes.reduce((sum, t) => sum + t.amount, 0);
            const netBalance = totalInc - totalExp;

            // Top Category Logic
            const catTotals = {};
            expenses.forEach(t => {
                catTotals[t.category] = (catTotals[t.category] || 0) + t.amount;
            });
            let topCat = '-';
            let maxVal = 0;
            for (const cat in catTotals) {
                if (catTotals[cat] > maxVal) {
                    maxVal = catTotals[cat];
                    topCat = cat;
                }
            }

            // Update UI Cards
            document.getElementById('totalIncome').innerText = formatIDR(totalInc);
            document.getElementById('totalSpending').innerText = formatIDR(totalExp);
            document.getElementById('netBalance').innerText = formatIDR(netBalance);
            document.getElementById('topCategory').innerText = topCat;

            // Dynamically adjust net balance card visual style if negative (deficit)
            const balanceCard = document.getElementById('netBalanceCard');
            const balanceText = document.getElementById('netBalance');
            if (netBalance < 0) {
                balanceCard.classList.replace('border-blue-500', 'border-rose-500');
                balanceText.className = "text-3xl font-extrabold text-red-600 mt-1";
            } else {
                balanceCard.classList.replace('border-rose-500', 'border-blue-500');
                balanceText.className = "text-3xl font-extrabold text-blue-600 mt-1";
            }

            // Update History Table (Last 10)
            const historyBody = document.getElementById('transactionHistory');
            historyBody.innerHTML = '';
            [...filtered].reverse().slice(0, 10).forEach(t => {
                const row = `
                    <tr class="border-b border-slate-50 hover:bg-slate-50 transition">
                        <td class="py-4 text-slate-500">${new Date(t.date).toLocaleDateString('id-ID', {day:'2-digit', month:'short'})}</td>
                        <td class="py-4 font-semibold text-slate-700">${t.name}</td>
                        <td class="py-4"><span class="px-2.5 py-1 bg-slate-100 rounded text-xs text-slate-600 font-semibold">${t.category}</span></td>
                        <td class="py-4 text-right font-bold ${t.type === 'Income' ? 'text-income' : 'text-expense'}">
                            ${t.type === 'Income' ? '+' : '-'}${formatIDR(t.amount)}
                        </td>
                        <td class="py-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="editTransaction(${t.id})" class="text-blue-600 hover:text-blue-800 hover:bg-blue-50 p-1.5 rounded-xl transition animate-pulse-hover" title="Edit Transaksi">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                <button onclick="confirmDelete(${t.id})" class="text-red-500 hover:text-red-700 hover:bg-red-50 p-1.5 rounded-xl transition" title="Hapus Transaksi">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                historyBody.innerHTML += row;
            });

            // Update Chart and Monthly Summary Table
            updateChart(catTotals);
            updateMonthlySummaryTable();
        }

        // NEW: MONTHLY SUMMARY RECAP GENERATOR
        function updateMonthlySummaryTable() {
            const summaryBody = document.getElementById('monthlySummary');
            summaryBody.innerHTML = '';

            // Group transactions by Year and Month
            const monthlyGroups = {};
            transactions.forEach(t => {
                const dateObj = new Date(t.date);
                const year = dateObj.getFullYear();
                const monthNum = dateObj.getMonth(); // 0-11
                const monthName = dateObj.toLocaleDateString('id-ID', { month: 'long', year: 'numeric' });
                const sortKey = `${year}-${String(monthNum + 1).padStart(2, '0')}`;

                if (!monthlyGroups[sortKey]) {
                    monthlyGroups[sortKey] = {
                        name: monthName,
                        income: 0,
                        expense: 0
                    };
                }

                if (t.type === 'Income') {
                    monthlyGroups[sortKey].income += t.amount;
                } else {
                    monthlyGroups[sortKey].expense += t.amount;
                }
            });

            // Sort keys descending (latest month first)
            const sortedKeys = Object.keys(monthlyGroups).sort().reverse();

            if (sortedKeys.length === 0) {
                summaryBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="py-8 text-center text-slate-400">Belum ada data keuangan bulanan untuk diringkas.</td>
                    </tr>
                `;
                return;
            }

            sortedKeys.forEach(key => {
                const data = monthlyGroups[key];
                const net = data.income - data.expense;
                const statusLabel = net >= 0 ? 'Surplus' : 'Defisit';
                const statusClass = net >= 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800';
                const netClass = net >= 0 ? 'text-emerald-600 font-extrabold' : 'text-rose-600 font-extrabold';

                const row = `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-4 font-bold text-slate-700">${data.name}</td>
                        <td class="py-4 text-right text-emerald-600 font-semibold">+${formatIDR(data.income)}</td>
                        <td class="py-4 text-right text-rose-500 font-semibold">-${formatIDR(data.expense)}</td>
                        <td class="py-4 text-right ${netClass}">${net >= 0 ? '+' : ''}${formatIDR(net)}</td>
                        <td class="py-4 text-center">
                            <span class="px-3 py-1 rounded-full text-xs font-bold ${statusClass}">
                                ${statusLabel}
                            </span>
                        </td>
                    </tr>
                `;
                summaryBody.innerHTML += row;
            });
        }

        function updateChart(catData) {
            const ctx = document.getElementById('categoryChart').getContext('2d');
            const rawLabels = Object.keys(catData);
            const rawData = Object.values(catData);
            
            // Calculate sum for percentages
            const totalCatSpending = rawData.reduce((sum, val) => sum + val, 0);
            
            // Convert to percentages
            const percentageData = rawData.map(val => 
                totalCatSpending > 0 ? parseFloat(((val / totalCatSpending) * 100).toFixed(1)) : 0
            );

            // Create multi-line labels: Line 1 = Category Name, Line 2 = Category Amount (Rp)
            const multiLineLabels = rawLabels.map((cat, idx) => [cat, formatIDR(rawData[idx])]);

            if (categoryChart) {
                categoryChart.destroy();
            }

            categoryChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: multiLineLabels,
                    datasets: [{
                        label: 'Persentase Pengeluaran (%)',
                        data: percentageData,
                        backgroundColor: '#3b82f6',
                        hoverBackgroundColor: '#1d4ed8',
                        borderRadius: 6,
                        barThickness: 24
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const index = context.dataIndex;
                                    const percentageValue = context.raw;
                                    const rupiahValue = rawData[index];
                                    return ` ${formatIDR(rupiahValue)} (${percentageValue}%)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { 
                            grid: { display: false },
                            ticks: { 
                                color: '#475569', 
                                font: { weight: 'bold', size: 10 },
                                maxRotation: 0,
                                autoSkip: false
                            }
                        },
                        y: { 
                            grid: { color: '#f1f5f9' },
                            ticks: { 
                                color: '#64748b', 
                                font: { weight: '600', size: 11 },
                                callback: function(value) {
                                    return value + '%';
                                }
                            },
                            min: 0,
                            max: Math.max(...percentageData, 10) > 80 ? 100 : undefined
                        }
                    }
                }
            });
        }


        // CORE GEMINI API FETCH HELPER
        async function callGemini(prompt, systemInstruction = "") {
            const apiKey = ""; // Canvas injects the API key automatically
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            
            const payload = {
                contents: [{ parts: [{ text: prompt }] }]
            };
            
            if (systemInstruction) {
                payload.systemInstruction = {
                    parts: [{ text: systemInstruction }]
                };
            }

            // Exponential Backoff algorithm for API resilience
            let delay = 1000;
            const maxRetries = 3;
            for (let i = 0; i < maxRetries; i++) {
                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    
                    if (response.status === 429) {
                        // Throttled: sleep then retry
                        await new Promise(resolve => setTimeout(resolve, delay));
                        delay *= 2;
                        continue;
                    }
                    
                    if (!response.ok) {
                        throw new Error(`API error with status code: ${response.status}`);
                    }
                    
                    const result = await response.json();
                    const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (!text) throw new Error("Empty candidate list returned");
                    return text;
                } catch (err) {
                    if (i === maxRetries - 1) throw err;
                    await new Promise(resolve => setTimeout(resolve, delay));
                    delay *= 2;
                }
            }
            throw new Error("Gagal terhubung dengan server AI.");
        }

        // FEATURE 1: GENERATE AI AUDIT REPORT
        async function generateAIAudit() {
            const placeholder = document.getElementById('auditPlaceholder');
            const loader = document.getElementById('auditLoader');
            const reportArea = document.getElementById('auditReport');

            placeholder.classList.add('hidden');
            loader.classList.remove('hidden');
            reportArea.classList.add('hidden');

            try {
                const systemPrompt = `Kamu adalah seorang auditor finansial profesional & perencana keuangan independen (CFP).
Tugasmu adalah menganalisis data transaksi yang disediakan oleh pengguna, melakukan audit mendalam, dan merumuskan laporan singkat, ringkas, dan praktis dalam Bahasa Indonesia.
Format laporan harus mencakup:
1. **Analisis Pola Pengeluaran**: Identifikasi kebiasaan belanja utama dan potensi pemborosan.
2. **3 Tips Penghematan Utama**: Langkah nyata dan spesifik yang bisa segera diambil berdasarkan pengeluaran terbesar mereka saat ini.
3. **Usulan Anggaran (Alokasi 50/30/20)**: Berikan saran pembagian alokasi dana ideal yang disesuaikan khusus untuk kondisi mereka.
Gunakan markdown profesional, tebalkan poin penting, dan jaga agar penjelasan tetap ramah serta dapat dieksekusi dalam dunia nyata.`;

                // Package transaction history as plain structured text
                const formattedHistory = transactions.map(t => `- ${t.date} | ${t.name} | Kategori: ${t.category} | ${t.type} | Rp ${t.amount}`).join('\n');
                const userPrompt = `Berikut adalah seluruh riwayat transaksi keuangan saya terbaru:\n${formattedHistory}\n\nTolong buatkan audit komprehensif sekarang.`;

                const aiOutput = await callGemini(userPrompt, systemPrompt);
                
                // Render with marked.js
                reportArea.innerHTML = marked.parse(aiOutput);
                
                loader.classList.add('hidden');
                reportArea.classList.remove('hidden');
                showToast("Laporan Audit Finansial AI berhasil dibuat!", "success");
            } catch (error) {
                console.error(error);
                loader.classList.add('hidden');
                placeholder.classList.remove('hidden');
                showToast("Oops, gagal membuat audit. Hubungkan kembali atau coba lagi.", "error");
            }
        }

        // FEATURE 2: INTERACTIVE ADVISOR CHATBOT
        let chatHistory = [];

        function appendMessage(sender, text) {
            const chatWindow = document.getElementById('chatWindow');
            const messageDiv = document.createElement('div');
            messageDiv.className = `flex gap-3 max-w-[85%] ${sender === 'user' ? 'ml-auto flex-row-reverse' : ''}`;
            
            const avatar = sender === 'user' ? 'Kamu' : 'AI';
            const avatarBg = sender === 'user' ? 'bg-blue-600 text-white' : 'bg-blue-100 text-blue-600';
            const msgBg = sender === 'user' ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-slate-100 text-slate-700 rounded-tl-none';

            // Parse text via marked for AI response
            const content = sender === 'ai' ? marked.parse(text) : `<p>${text}</p>`;

            messageDiv.innerHTML = `
                <div class="h-8 w-8 rounded-full ${avatarBg} flex items-center justify-center text-xs font-bold flex-shrink-0">${avatar}</div>
                <div class="${msgBg} p-3 rounded-2xl leading-relaxed markdown-body">
                    ${content}
                </div>
            `;
            
            chatWindow.appendChild(messageDiv);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        async function handleSendChat() {
            const inputEl = document.getElementById('chatInput');
            const query = inputEl.value.trim();
            if (!query) return;

            inputEl.value = '';
            appendMessage('user', query);

            // Add typing indicator
            const typingIndicator = document.createElement('div');
            typingIndicator.id = 'typingIndicator';
            typingIndicator.className = 'flex gap-3 max-w-[85%]';
            typingIndicator.innerHTML = `
                <div class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xs font-bold flex-shrink-0">AI</div>
                <div class="bg-slate-100 p-3 rounded-2xl rounded-tl-none text-slate-500 italic flex items-center gap-2">
                    <svg class="animate-spin h-4 w-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    KawanKeuangan sedang mengetik...
                </div>
            `;
            document.getElementById('chatWindow').appendChild(typingIndicator);
            document.getElementById('chatWindow').scrollTop = chatWindow.scrollHeight;

            try {
                const systemPrompt = `Kamu adalah "KawanKeuangan", seorang penasihat keuangan pribadi yang ramah, berempati tinggi, dan profesional asal Indonesia.
Bantu pengguna mengelola uang dengan cerdas. Berikan saran realistis dan mendasar di konteks finansial Indonesia (misal: penggunaan IDR, tips menabung yang cocok dengan gaya hidup lokal).
Gunakan pemformatan markdown yang baik (bullet points, bolding). Jawablah dengan singkat dan bersahabat (maksimal 2-3 paragraf per pesan).`;

                // Add current financial snapshot to context
                const totalSpent = document.getElementById('totalSpending').innerText;
                const topCat = document.getElementById('topCategory').innerText;
                const contextSummary = `\n[Info Keuangan Pengguna saat ini: Total Pengeluaran ${totalSpent} dan Kategori Pengeluaran Terbesar adalah ${topCat}]`;

                const responseText = await callGemini(query + contextSummary, systemPrompt);
                
                // Remove indicator and show reply
                document.getElementById('typingIndicator').remove();
                appendMessage('ai', responseText);
            } catch (error) {
                console.error(error);
                document.getElementById('typingIndicator').remove();
                appendMessage('ai', "Maaf, koneksi saya sedang terganggu. Mari coba ajukan pertanyaan Anda kembali.");
            }
        }

        function sendSuggested(promptText) {
            document.getElementById('chatInput').value = promptText;
            handleSendChat();
        }

        function clearChat() {
            const chatWindow = document.getElementById('chatWindow');
            chatWindow.innerHTML = `
                <div class="flex gap-3 max-w-[85%]">
                    <div class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xs font-bold flex-shrink-0">AI</div>
                    <div class="bg-slate-100 p-3 rounded-2xl rounded-tl-none text-slate-700 leading-relaxed">
                        Halo kembali! Saya <b>KawanKeuangan AI</b>. Silakan tanyakan hal lain seputar perencanaan finansial Anda.
                    </div>
                </div>
            `;
            showToast("Riwayat obrolan dibersihkan.");
        }

